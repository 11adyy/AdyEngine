<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net7.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>AdyEngine</PackageId>
        <Title>Ady Engine</Title>
        <Authors>Noah Dylan Pelegrini</Authors>
        <Description>Simple library for working and understanding raycasting and 3D</Description>
        <PackageIcon>Asset_1_1x.png</PackageIcon>
        <RepositoryUrl>https://github.com/11adyy/AdyEngine</RepositoryUrl>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
      <None Update="Asset_1_1x.png">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
    </ItemGroup>

</Project>
